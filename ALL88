# Payment status helpers
# -------------------------
def set_unpaid_status(record: dict, as_of_date: str = None, note: str = None):
    if as_of_date is None:
        as_of_date = date.today().isoformat()
    record["payment_status"] = {
        "status": "No compensation received",
        "as_of_date": as_of_date,
        "note": note or "Declared by rights holder."
    }
    record["record_generated_on"] = date.today().isoformat()
    return record

def set_paid_status(record: dict, as_of_date: str = None, amount: str = None, note: str = None):
    if as_of_date is None:
        as_of_date = date.today().isoformat()
    record["payment_status"] = {
        "status": "Compensation received",
        "as_of_date": as_of_date,
        "amount": amount,
        "note": note or ""
    }
    record["record_generated_on"] = date.today().isoformat()
    return record

