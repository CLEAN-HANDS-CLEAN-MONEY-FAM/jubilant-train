{
  "description": "Patterns that trigger sanitization alerts or bans",
  "last_updated": "2026-01-01",
  "banned_patterns": [
    {
      "pattern": "GPL-2\\.0|GPL-3\\.0",
      "type": "license",
      "severity": "critical",
      "description": "GNU General Public License v2/v3 - copyleft license incompatible with proprietary software",
      "action": "block"
    },
    {
      "pattern": "AGPL-3\\.0|Affero",
      "type": "license",
      "severity": "critical",
      "description": "GNU Affero General Public License - requires source disclosure for network use",
      "action": "block"
    },
    {
      "pattern": "GFDL",
      "type": "license",
      "severity": "high",
      "description": "GNU Free Documentation License - copyleft for documentation",
      "action": "block"
    },
    {
      "pattern": "copyleft",
      "type": "keyword",
      "severity": "high",
      "description": "Indicates potential copyleft license requirement",
      "action": "warn"
    },
    {
      "pattern": "free\\s+software\\s+foundation",
      "type": "organization",
      "severity": "high",
      "description": "FSF projects often use GPL/AGPL licenses",
      "action": "warn"
    },
    {
      "pattern": "license.*gpl|gpl.*license",
      "type": "license_reference",
      "severity": "critical",
      "description": "Explicit GPL license reference",
      "action": "block"
    },
    {
      "pattern": "license.*agpl|agpl.*license",
      "type": "license_reference",
      "severity": "critical",
      "description": "Explicit AGPL license reference",
      "action": "block"
    },
    {
      "pattern": "derivative\\s+work|derived\\s+from",
      "type": "legal_term",
      "severity": "medium",
      "description": "May indicate GPL/AGPL derived code",
      "action": "warn"
    },
    {
      "pattern": "source.*available|available.*source",
      "type": "legal_term",
      "severity": "medium",
      "description": "May indicate source disclosure requirement",
      "action": "warn"
    }
  ],
  "pattern_flags": {
    "case_insensitive": true,
    "multiline": true
  },
  "enforcement_notes": [
    "All patterns are evaluated as regex expressions",
    "Multiple patterns may match - all matches are logged",
    "Critical/block patterns prevent sanitization until resolved",
    "Warning patterns allow sanitization but flag in audit log"
  ]
}
