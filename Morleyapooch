const fs = require('fs');
const path = require('path');
const crypto = require('crypto');

// Target extensions corresponding to the master compilation bundle mapping
const TARGET_EXTENSIONS = ['.dart', '.py', '.json', '.yaml', '.xml', '.md', '.txt', '.js', '.html', '.css'];
const EXCLUDE_DIRS = ['.git', 'build', '.dart_tool', 'node_modules', '__pycache__'];

function computeFileHash(filePath) {
    const fileBuffer = fs.readFileSync(filePath);
    return crypto.createHash('sha256').update(fileBuffer).digest('hex');
}

function traverseAndVerify(dir, accumulatedHashes = []) {
    const files = fs.readdirSync(dir);

    files.forEach(file => {
        const fullPath = path.join(dir, file);
        const stat = fs.statSync(fullPath);

        if (stat.isDirectory()) {
            if (!EXCLUDE_DIRS.includes(file)) {
                traverseAndVerify(fullPath, accumulatedHashes);
            }
        } else {
            const ext = path.extname(file);
            if (TARGET_EXTENSIONS.includes(ext) && file !== 'master_bundle.json' && file !== 'verify_signatures.js') {
                const fileHash = computeFileHash(fullPath);
                accumulatedHashes.push(fileHash);
                const relPath = path.relative(__dirname, fullPath);
                console.log(`🔒 Integrity Verified [SHA-256]: ${relPath} -> ${fileHash}`);
            }
        }
    });

    return accumulatedHashes;
}

