# Secure local vault using AES-GCM (cryptography)
from cryptography.hazmat.primitives.ciphers.aead import AESGCM
from cryptography.hazmat.primitives.kdf.scrypt import Scrypt
from cryptography.hazmat.primitives import hashes
from cryptography.hazmat.primitives import constant_time
from pathlib import Path
import base64, secrets, json
from datetime import datetime

VAULT_DIR = Path(".master_lock")
VAULT_DIR.mkdir(exist_ok=True)
VAULT_FILE = VAULT_DIR / "vault.bin"
META_FILE = VAULT_DIR / "vault_meta.json"

SCRYPT_N = 2**14
SCRYPT_R = 8
SCRYPT_P = 1
KEY_LEN = 32
NONCE_LEN = 12

def _derive_key(passphrase: bytes, salt: bytes):
    kdf = Scrypt(salt=salt, length=KEY_LEN, n=SCRYPT_N, r=SCRYPT_R, p=SCRYPT_P)
    return kdf.derive(passphrase)

def _encrypt(plaintext: bytes, key: bytes):
    aesgcm = AESGCM(key)
    nonce = secrets.token_bytes(NONCE_LEN)
    ct = aesgcm.encrypt(nonce, plaintext, None)
    return {"nonce": base64.b64encode(nonce).decode(), "ciphertext": base64.b64encode(ct).decode()}

def _decrypt(nonce_b64, ct_b64, key):
    aesgcm = AESGCM(key)
    nonce = base64.b64decode(nonce_b64)
    ct = base64.b64decode(ct_b64)
    return aesgcm.decrypt(nonce, ct, None)

def init_vault(passphrase: str):
    if VAULT_FILE.exists():
        raise FileExistsError("Vault already exists.")
    salt = secrets.token_bytes(16)
    key = _derive_key(passphrase.encode(), salt)
    empty = json.dumps({"entries": [], "created_on": datetime.utcnow().isoformat()}).encode()
    enc = _encrypt(empty, key)
    with VAULT_FILE.open("wb") as f:
        f.write(base64.b64encode(json.dumps(enc).encode()))
    with META_FILE.open("w", encoding="utf-8") as f:
        json.dump({"salt": base64.b64encode(salt).decode(), "created_on": datetime.utcnow().isoformat()}, f, indent=2)
    return True

def _load_key(passphrase: str):
    if not META_FILE.exists():
        raise FileNotFoundError("Vault metadata not found.")
    meta = json.load(META_FILE.open("r", encoding="utf-8"))
    salt = base64.b64decode(meta["salt"])
    return _derive_key(passphrase.encode(), salt)

def _read_blob():
    if not VAULT_FILE.exists():
        raise FileNotFoundError("Vault file not found.")
    raw = base64.b64decode(VAULT_FILE.read_bytes())
    return json.loads(raw.decode())

def list_entries(passphrase: str):
    key = _load_key(passphrase)
    enc = _read_blob()
    plaintext = _decrypt(enc["nonce"], enc["ciphertext"], key)
    data = json.loads(plaintext.decode())
    return [{"id": e["id"], "label": e.get("label"), "created_on": e.get("created_on")} for e in data["entries"]]

def add_entry(passphrase: str, label: str, payload: dict):
    key = _load_key(passphrase)
    enc = _read_blob()
    plaintext = _decrypt(enc["nonce"], enc["ciphertext"], key)
    data = json.loads(plaintext.decode())
    entry_id = secrets.token_hex(12)
    entry = {"id": entry_id, "label": label, "payload": payload, "created_on": datetime.utcnow().isoformat()}
    data["entries"].append(entry)
    new_plain = json.dumps(data).encode()
    new_enc = _encrypt(new_plain, key)
    with VAULT_FILE.open("wb") as f:
        f.write(base64.b64encode(json.dumps(new_enc).encode()))
    return entry_id

def get_entry(passphrase: str, entry_id: str):
    key = _load_key(passphrase)
    enc = _read_blob()
    plaintext = _decrypt(enc["nonce"], enc["ciphertext"], key)
    data = json.loads(plaintext.decode())
    for e in data["entries"]:
        if constant_time.bytes_eq(e["id"].encode(), entry_id.encode()):
            return e
    raise KeyError("Entry not found")

def delete_entry(passphrase: str, entry_id: str):
    key = _load_key(passphrase)
    enc = _read_blob()
    plaintext = _decrypt(enc["nonce"], enc["ciphertext"], key)
    data = json.loads(plaintext.decode())
    new_entries = [e for e in data["entries"] if not constant_time.bytes_eq(e["id"].encode(), entry_id.encode())]
    if len(new_entries) == len(data["entries"]):
        raise KeyError("Entry not found")
    data["entries"] = new_entries
    new_plain = json.dumps(data).encode()
    new_enc = _encrypt(new_plain, key)
    with VAULT_FILE.open("wb") as f:
        f.write(base64.b64encode(json.dumps(new_enc).encode()))
    return True

def export_entry_hash(payload: dict):
    digest = hashes.Hash(hashes.SHA256())
    canonical = json.dumps(payload, separators=(",", ":"), sort_keys=True).encode()
    digest.update(canonical)
    return digest.finalize().hex()
