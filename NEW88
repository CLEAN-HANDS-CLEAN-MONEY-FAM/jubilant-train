import argparse, getpass, json
from master_lock import init_vault, add_entry, list_entries, get_entry, delete_entry, export_entry_hash

def cmd_init(args):
    passphrase = getpass.getpass("Enter new vault passphrase: ")
    confirm = getpass.getpass("Confirm passphrase: ")
    if passphrase != confirm:
        print("Passphrases do not match.")
        return
    try:
        init_vault(passphrase)
        print("Vault initialized at .master_lock/")
    except Exception as e:
        print("Error:", e)

def cmd_add(args):
    passphrase = getpass.getpass("Vault passphrase: ")
    label = args.label or input("Label for entry: ")
    if args.file:
        with open(args.file, "r", encoding="utf-8") as f:
            payload = json.load(f)
    else:
        raw = input("Paste JSON payload (single line): ")
        payload = json.loads(raw)
    entry_id = add_entry(passphrase, label, payload)
    h = export_entry_hash(payload)
    print(f"Added entry id: {entry_id}")
    print(f"Public SHA-256 anchor: {h}")

def cmd_list(args):
    passphrase = getpass.getpass("Vault passphrase: ")
    try:
        entries = list_entries(passphrase)
        for e in entries:
            print(f"{e['id']}  | {e.get('label')}  | created: {e.get('created_on')}")
    except Exception as ex:
        print("Error:", ex)

def cmd_get(args):
    passphrase = getpass.getpass("Vault passphrase: ")
    try:
        e = get_entry(passphrase, args.id)
        if args.out:
            with open(args.out, "w", encoding="utf-8") as f:
                json.dump(e, f, indent=2, ensure_ascii=False)
            print(f"Wrote decrypted entry to {args.out} (remove file after use).")
        else:
            print("Entry metadata:")
            print(f"id: {e['id']}")
            print(f"label: {e.get('label')}")
            print(f"created_on: {e.get('created_on')}")
            print("Payload not printed. Use --out to write decrypted JSON locally.")
    except Exception as ex:
        print("Error:", ex)

def cmd_delete(args):
    passphrase = getpass.getpass("Vault passphrase: ")
    try:
        delete_entry(passphrase, args.id)
        print("Deleted entry.")
    except Exception as ex:
        print("Error:", ex)

def main():
    parser = argparse.ArgumentParser(description="Master Lock CLI")
    sub = parser.add_subparsers(dest="cmd")
    p_init = sub.add_parser("init")
    p_init.set_defaults(func=cmd_init)
    p_add = sub.add_parser("add")
    p_add.add_argument("--label", help="Label for entry")
    p_add.add_argument("--file", help="JSON file containing payload")
    p_add.set_defaults(func=cmd_add)
    p_list = sub.add_parser("list")
    p_list.set_defaults(func=cmd_list)
    p_get = sub.add_parser("get")
    p_get.add_argument("id", help="Entry id")
    p_get.add_argument("--out", help="Write decrypted entry to file (local only)")
    p_get.set_defaults(func=cmd_get)
    p_del = sub.add_parser("delete")
    p_del.add_argument("id", help="Entry id")
    p_del.set_defaults(func=cmd_delete)
    args = parser.parse_args()
    if not hasattr(args, "func"):
        parser.print_help()
        return
    args.func(args)

if __name__ == "__main__":
    main()
