from master_lock import export_entry_hash

def build_notarization_bundle(entry_payload: dict, label: str, evidence_links: list = None):
    h = export_entry_hash(entry_payload)
    bundle = {
        "label": label,
        "hash": h,
        "evidence_links": evidence_links or [],
        "created_on": datetime.utcnow().isoformat(),
        "affidavit": f"I, MORLEYMOSESAPOOCH*, declare that the sensitive identifiers associated with label '{label}' are held securely by me. The SHA-256 hash of the canonical payload is {h}. The raw identifiers are not published here."
    }
    return bundle

def save_bundle(bundle: dict, path: str):
    p = Path(path)
    p.parent.mkdir(parents=True, exist_ok=True)
    with p.open("w", encoding="utf-8") as f:
        json.dump(bundle, f, indent=2, ensure_ascii=False)
    return str(p.resolve())
