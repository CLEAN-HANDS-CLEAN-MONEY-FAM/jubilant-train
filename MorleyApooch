set -euo pipefail

# ==============================================================================
# Configuration - Customize per deployment
# ==============================================================================
declare -A BLOCKCHAIN_ENDPOINTS=(
    ["ethereum_mainnet"]="https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY"
    ["polygon_mainnet"]="https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY"
    ["arbitrum_one"]="https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY"
    ["optimism"]="https://opt-mainnet.g.alchemy.com/v2/YOUR_KEY"
    ["bitcoin_mainnet"]="https://api.blockcypher.com/v1/btc/main"
)

# Smart contract addresses for hash anchoring (update with deployed contracts)
declare -A ANCHOR_CONTRACTS=(
    ["ethereum"]="0x1234567890abcdef1234567890abcdef12345678"
    ["polygon"]="0xabcdef1234567890abcdef1234567890abcdef12"
    ["arbitrum"]="0x567890abcdef1234567890abcdef1234567890ab"
)

WALLET_ADDRESS="${WALLET_ADDRESS:-0x...}"  # Replace with your wallet
PRIVATE_KEY_FILE="${PRIVATE_KEY_FILE:-$HOME/.keys/ip_anchor.key}"  # NEVER commit this!
GAS_LIMIT_DEFAULT="100000"
RPC_TIMEOUT="30"

# ==============================================================================
# Helper Functions
# ==============================================================================

log_info() { echo -e "[\033[0;32mINFO\033[0m] $1"; }
log_warn() { echo -e "[\033[1;33mWARN\033[0m] $1"; }
log_error() { echo -e "[\033[0;31mERROR\033[0m] $1"; exit 1; }

check_dependency() {
    if ! command -v "$1" &> /dev/null; then
        log_error "$1 is required but not installed"
    fi
}

validate_hash() {
    local hash="$1"
    if [[ ! "$hash" =~ ^[a-f0-9]{64}$ ]]; then
        log_error "Invalid SHA-256 hash format: $hash"
    fi
}

# ==============================================================================
# Ethereum/Polygon/Arbitrum Anchoring via Solidity Contract
# ==============================================================================

submit_to_ethereum_network() {
    local network="$1"
    local package_hash="$2"
    local endpoint="${BLOCKCHAIN_ENDPOINTS[$network]}"
    local contract="${ANCHOR_CONTRACTS[$network]}"
    
    log_info "Submitting to ${network^} network..."
    
    # Validate prerequisites
    check_dependency "cast"  # Foundry CLI for contract interaction
    validate_hash "$package_hash"
    
    # Check wallet balance
    local balance
    balance=$(cast balance "$WALLET_ADDRESS" --rpc-url "$endpoint" 2>/dev/null || echo "0")
    
    if [ "$balance" == "0" ]; then
        log_warn "Insufficient balance on ${network}. Skipping anchor submission."
        return 1
    fi
    
    # Submit hash to smart contract (adjust method name per deployed contract)
    log_info "Calling anchorHash() function on contract ${contract}..."
    
    cast send "$contract" "anchorHash(string)" "$package_hash" \
        --rpc-url "$endpoint" \
        --private-key "$(cat "$PRIVATE_KEY_FILE")" \
        --gas-limit "$GAS_LIMIT_DEFAULT" \
        --timeout "$RPC_TIMEOUT" \
        --json | jq '.transactionHash' > "/tmp/${network}_tx_hash.json" 2>/dev/null || {
            log_warn "Transaction submission failed. Manual submission required."
            return 1
        }
    
    local tx_hash
    tx_hash=$(cat "/tmp/${network}_tx_hash.json" | tr -d '"')
    
    # Save anchor record
    cat > "/tmp/${network}_anchor_record.json" <<EOF
{
  "network": "${network}",
  "package_hash": "${package_hash}",
  "transaction_hash": "${tx_hash}",
  "timestamp_utc": "$(date -u +%FT%TZ)",
  "explorer_url": "https://${network}.etherscan.io/tx/${tx_hash}",
  "owner": "apoochmorley@protonmail.com",
  "purpose": "IP Evidence Anchor - CLEAN-HANDS-CLEAN-MONEY-FAM"
}
EOF
    
    log_info "${network^} anchor submitted successfully"
    log_info "Explorer: https://${network}.etherscan.io/tx/${tx_hash}"
    return 0
}

# ==============================================================================
# Bitcoin OP_RETURN Anchoring (No Smart Contract Required)
# ==============================================================================

submit_to_bitcoin_network() {
    local package_hash="$1"
    
    log_info "Submitting to Bitcoin mainnet via OP_RETURN..."
    
    check_dependency "btcutils"  # Or use bitcoin-cli with proper setup
    
    # Convert hash to hex for OP_RETURN (first 80 bytes max)
    local op_return_data="IP_PROOF:${package_hash:0:40}"  # Truncate if needed
    
    # This requires funded wallet with UTXOs
    # Implementation depends on preferred wallet interface
    log_warn "Bitcoin anchoring requires manual setup. Use recommended service:"
    log_warn "  - OpReturn.org (API-based)"
    log_warn "- Factom (layer-2 Bitcoin anchoring)"
    log_warn "- Bitseed (direct broadcast)"
    
    # Create pending anchor file
    cat > "/tmp/bitcoin_pending_anchor.json" <<EOF
{
  "network": "bitcoin_mainnet",
  "package_hash": "${package_hash}",
  "op_return_data": "${op_return_data}",
  "status": "pending_manual_broadcast",
  "recommended_services": [
    "https://opreturn.org/api",
    "https://factom.com",
    "https://bitseed.xyz"
  ],
  "timestamp": "$(date -u +%FT%TZ)"
}
EOF
    
    return 1  # Placeholder - requires external service
}

# ==============================================================================
# Fallback: Decentralized Storage Anchoring
# ==============================================================================

fallback_to_ipfs_arweave() {
    local package_dir="$1"
    local package_hash="$2"
    
    log_info "Creating decentralized storage backups..."
    
    # Check for IPFS node or gateway
    if command -v ipfs &> /dev/null; then
        log_info "Uploading to IPFS..."
        local cid
        cid=$(ipfs add -r "${package_dir}" | grep "added" | tail -1 | awk '{print $2}')
        
        cat >> "/tmp/decentralized_anchor.json" <<EOF
{
  "storage_type": "IPFS",
  "cid": "${cid}",
  "gateway_url": "https://ipfs.io/ipfs/${cid}",
  "pin_status": "active",
  "backup_gateways": [
    "https://cloudflare-ipfs.com/ipfs/${cid}",
    "https://dweb.link/ipfs/${cid}"
  ]
}
EOF
    else
        log_warn "IPFS not available. Skipping decentralized backup."
    fi
    
    # Arweave anchor (requires permaweb wallet)
    if command -v arcli &> /dev/null; then
        log_info "Uploading to Arweave Permaweb..."
        # Similar process - archive dependent on wallet config
    fi
    
    return 0
}

# ==============================================================================
# Main Orchestrator
# ==============================================================================

main() {
    local package_hash="$1"
    local target_networks="${2:-ethereum,polygon}"  # Default to EVM-compatible chains
    
    log_info "=========================================="
    log_info "  MULTI-NETWORK BLOCKCHAIN ANCHORER"
    log_info "  Package Hash: ${package_hash}"
    log_info "  Networks: ${target_networks}"
    log_info "=========================================="
    
    # Create consolidated anchor record
    local anchor_json="/tmp/consolidated_anchor_${package_hash:0:8}.json"
    
    cat > "$anchor_json" <<EOF
{
  "anchor_package": {
    "owner": "Morley Moses Apooch",
    "contact": "apoochmorley@protonmail.com",
    "package_hash": "${package_hash}",
    "created_at": "$(date -u +%FT%TZ)",
    "legal_context": "IP Protection - Global Asset Protection Lock Protocol"
  },
  "network_submissions": []
}
EOF
    
    # Attempt each network
    IFS=',' read -ra NETWORKS <<< "$target_networks"
    local success_count=0
    
    for network in "${NETWORKS[@]}"; do
        if submit_to_ethereum_network "$network" "$package_hash"; then
            ((success_count++))
            # Append successful anchor to consolidated record
            cat "/tmp/${network}_anchor_record.json" >> "$anchor_json"
        else
            log_warn "${network^} anchoring failed or skipped"
        fi
    done
    
    # Fallback to decentralized storage
    fallback_to_ipfs_arweave "${REPO_ROOT}/evidence_packages/latest/" "$package_hash"
    
    log_info "=========================================="
    log_info "  ANCHORING SUMMARY"
    log_info "  Successful: ${success_count}/${#NETWORKS[@]}"
    log_info "  Consolidated Record: ${anchor_json}"
    log_info "=========================================="
    
    if [ "$success_count" -eq 0 ]; then
        log_warn "No blockchain anchors achieved. Consider funding wallets or using alternative services."
    fi
}

